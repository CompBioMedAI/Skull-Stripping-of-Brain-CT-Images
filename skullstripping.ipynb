import cv2
import numpy as np
import matplotlib.pyplot as plt
import os


input_folder = 'File_location/inuput_image'
output_folder = 'File_location/output_image'


os.makedirs(output_folder, exist_ok=True)

for filename in os.listdir(input_folder):
    input_path = os.path.join(input_folder, filename)
   
    if not filename.lower().endswith(('.png', '.jpg', '.jpeg', '.bmp', '.tif', '.tiff')):
        continue
   
    image = cv2.imread(input_path, cv2.IMREAD_GRAYSCALE)
    if image is None:
        print(f"Failed to load {input_path}")
        continue
   
    plt.imshow(image, cmap='gray')
    plt.title(f'Original Image - {filename}')
    plt.show()

    # Apply thresholding
    _, boundary_thresh = cv2.threshold(image, 220, 255, cv2.THRESH_BINARY)

    # Apply morphological closing to connect regions
    kernel = np.ones((20, 20), np.uint8)
    closed_boundary = cv2.morphologyEx(boundary_thresh, cv2.MORPH_CLOSE, kernel)

    # Find and filter contours
    contours, _ = cv2.findContours(closed_boundary, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
    min_area = 500  
    filtered_contours = [c for c in contours if cv2.contourArea(c) > min_area]

    # Create a mask for the filtered contours
    mask = np.zeros_like(image)
    cv2.drawContours(mask, filtered_contours, -1, 255, thickness=cv2.FILLED)

    # Apply distance transform to refine the mask
    distance_transform = cv2.distanceTransform(mask, cv2.DIST_L2, 5)
    _, distance_thresh = cv2.threshold(distance_transform, 10, 255, cv2.THRESH_BINARY)
    distance_thresh = np.uint8(distance_thresh)
    refined_mask = cv2.bitwise_and(mask, distance_thresh)

    # Apply the refined mask to the image
    inner_segmented = cv2.bitwise_and(image, image, mask=refined_mask)
    inner_segmented[inner_segmented >= 240] = 0

    plt.imshow(inner_segmented, cmap='gray')
    plt.title(f'Refined Inner Segmented Image - {filename}')
    plt.show()

    output_path = os.path.join(output_folder, filename)
    cv2.imwrite(output_path, inner_segmented)
    print(f"Processed and saved: {output_path}")